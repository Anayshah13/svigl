# Copy to .env.local (never commit .env.local)
#
# --- Required ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI in Google Cloud Console.
# Dev:  http://localhost:8000/auth/google/callback
# Prod: https://<your-api-host>/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Frontend origin used for CORS + post-login redirects (no trailing slash).
# Dev:  http://localhost:3000
# Prod: https://<your-frontend-origin>
# Post-OAuth browser redirect + primary CORS origin. Production must be the
# live site origin (e.g. https://svigl.com), not a stale preview/deploy URL.
FRONTEND_URL=http://localhost:3000
SESSION_SECRET_KEY=change-me-to-a-long-random-string

# Prefer JWT_SECRET (also accepts legacy JWT_SECRET_KEY).
JWT_SECRET=change-me-to-a-long-random-string
# Prefer minutes (also accepts legacy JWT_EXPIRATION_SECONDS).
JWT_EXPIRE_MINUTES=10080

# Cookie flags — do not hardcode in code; set per environment.
# Dev (localhost):
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Prod (cross-site frontend + API):
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
# Prod (same-site, e.g. app.example.com + api.example.com):
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax

# Optional: comma-separated extra CORS origins (in addition to FRONTEND_URL).
# CORS_ORIGINS=http://localhost:3000,https://staging.example.com

# Database: either DATABASE_URL OR POSTGRES_* (e.g. docker-compose).
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Optional: AI Guesser (/ai-guesser experimental demo) ---
# Unset leaves the feature disabled: the page still lets you draw and the AI
# panel reports "AI unavailable". Get a key from https://aistudio.google.com/
# GEMINI_API_KEY=
# Low-cost multimodal Flash/Lite tier. Do not point this at a Pro model —
# it is called once every few seconds per player.
# GEMINI_AI_GUESSER_MODEL=gemini-3.5-flash-lite
# Per-request upstream timeout (seconds).
# GEMINI_TIMEOUT_SECONDS=18
# Gemini 3.x thinking depth. "minimal" is the latency/cost default.
# GEMINI_THINKING_LEVEL=minimal
# Legacy Gemini 2.5 knob. Ignored when GEMINI_THINKING_LEVEL is set. -1 omits.
# GEMINI_THINKING_BUDGET=-1
# Per-IP abuse guard (per process). 15 matches typical free-tier Flash-Lite RPM.
# AI_GUESSER_RATE_LIMIT_PER_MINUTE=15
# AI_GUESSER_DAILY_LIMIT_PER_IP=150
# AI_GUESSER_DAILY_GLOBAL_LIMIT=800
# Only set true behind a proxy that overwrites X-Forwarded-For / X-Real-IP.
# AI_GUESSER_TRUST_FORWARDED_FOR=false
# AI_GUESSER_MAX_IMAGE_BYTES=200000
# Gemini TTS (same GEMINI_API_KEY). Speaks the guesser's line as the drawing
# changes. Unset model keeps the default preview TTS id.
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_TTS_VOICE=Puck
# GEMINI_TTS_TIMEOUT_SECONDS=12
# AI_GUESSER_TTS_RATE_LIMIT_PER_MINUTE=15
# AI_GUESSER_TTS_DAILY_LIMIT_PER_IP=150
#
# --- Optional: multiplayer system bot (regular rooms) ---
# Guess-only seat. Separate from the public /ai-guesser rate-limit route.
# BOT_GUESS_DEBOUNCE_SECONDS=4
# BOT_GUESS_INTERVAL_SECONDS=5
# BOT_GUESS_TIMEOUT_SECONDS=18
# BOT_MAX_GUESS_CALLS_PER_TURN=12
# BOT_GLOBAL_AI_CONCURRENCY=4
# BOT_GUESS_MIN_CONFIDENCE=0.5
#
# Same EmailJS template as /feedback — mails anayshah10@gmail.com on 429s.
# EMAILJS_SERVICE_ID=
# EMAILJS_TEMPLATE_ID=
# EMAILJS_PUBLIC_KEY=
# EMAILJS_ALERT_TO=anayshah10@gmail.com
