# Frontend (inlined at Next.js build time — set on Vercel and redeploy)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# Leave unset locally to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# EmailJS — powers the /feedback form and AI-guesser limit alerts.
# These ship in the client bundle (not secret), but keep them out of source
# and restrict allowed origins in the EmailJS dashboard.
# Leave unset to disable the feedback form.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
